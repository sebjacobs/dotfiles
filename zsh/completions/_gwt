#compdef gwt

# Completion for `gwt` (zsh/gwt.zsh — git worktree helpers for .claude/worktrees/).
#
# First word: the subcommands, kept in sync with the binary's command list by the
# completion-drift smoke test (test/shell/completion_drift_test.rb). The
# worktree-taking subcommands (cd/rm/path/edit/mv/sync/promote) complete an
# existing worktree's name from the .claude/worktrees/ dirs; add completes branch
# names. Flag-taking subcommands (rm/sync/promote/mv/add) offer their flags when
# the current word starts with `-`, and still complete the worktree name after a
# flag (e.g. `gwt rm -D <name>`). mv's second word (the new name) is free text.

_gwt_root() { git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //'; }

_gwt() {
  local root=$(_gwt_root)
  if [[ -z "$root" ]]; then return; fi
  local wt_base="$root/${GWT_WORKTREE_DIR:-.claude/worktrees}"

  if [[ "${words[2]}" == send ]] && (( CURRENT >= 3 )); then
    case "${words[CURRENT-1]}" in
      --from|--to) compadd -- root "$wt_base"/*(/:t) ;;
      *) if (( CURRENT == 3 )); then _files; else compadd -- --from --to -f -y; fi ;;
    esac
    return
  fi

  if (( CURRENT == 2 )); then
    zstyle ':completion:*:*:gwt:*' group-name ''
    zstyle ':completion:*:*:gwt:*' group-order commands worktrees
    local -a _subcommands=(init add sync promote send cd mv path edit ls rm prune root status)  # @subcommands
    compadd -J commands -X 'commands' -- $_subcommands
    if [[ -d "$wt_base" ]]; then
      compadd -J worktrees -X 'worktrees' -- "$wt_base"/*(/:t)
    fi
  elif (( CURRENT >= 3 )); then
    local cur="${words[CURRENT]}"
    local -a wts
    [[ -d "$wt_base" ]] && wts=("$wt_base"/*(/:t))
    case "${words[2]}" in
      rm)
        if [[ "$cur" == -* ]]; then compadd -- -f -d -D; else compadd -- $wts; fi
        ;;
      sync)
        if [[ "$cur" == -* ]]; then compadd -- --all -f -y --hooks; else compadd -- $wts; fi
        ;;
      promote)
        if [[ "$cur" == -* ]]; then compadd -- -f -y; else compadd -- $wts; fi
        ;;
      cd|path|edit)
        (( CURRENT == 3 )) && compadd -- $wts
        ;;
      mv)
        if [[ "$cur" == -* ]]; then compadd -- -f
        elif (( CURRENT == 3 )); then compadd -- $wts; fi
        ;;
      add)
        if [[ "$cur" == -* ]]; then compadd -- -b
        else compadd -- $(git branch --format='%(refname:short)' 2>/dev/null); fi
        ;;
      root)
        compadd -- -p --path
        ;;
    esac
  fi
}

_gwt "$@"
