#!/usr/bin/env zsh
# display-font — size editor/terminal fonts from the connected display.
#
# The built-in Retina panel is the reference: BASE_SIZE is calibrated to feel
# right there. An external monitor sits further away, so it gets a larger,
# rounded size (BASE_SIZE * EXTERNAL_SCALE). There is no OS-level base font to
# derive from, so we detect the display and render the values ourselves.
#
# Detection is clamshell-proof: only external displays report a ProductName in
# ioreg (the built-in panel reports none), so any non-built-in ProductName means
# an external is attached regardless of lid state.
#
# Renders each app's tracked template into its live (generated) config; Zed and
# iTerm both hot-reload, so open windows resize without a restart.

set -eu
setopt null_glob

DOTFILES="${DOTFILES_HOME:-$HOME/dotfiles}"
BASE_SIZE=16
EXTERNAL_SCALE=1.5

# Firefox's layout.css.devPixelsPerPx is an *absolute* scale, not a multiplier,
# so it can't reuse EXTERNAL_SCALE — it needs a real per-display value calibrated
# live in about:config (the pref applies with no restart). 2.2 nudges the Retina
# built-in (auto ~2.0) up a touch; the external is a HiDPI panel that sits further
# away, so 2.4 sizes it to feel right at that distance. An absolute below a
# display's own auto shrinks the UI, so each value stays at or above its baseline.
BUILTIN_DPPX=2.2
EXTERNAL_DPPX=2.4

external_connected() {
  ioreg -lw0 2>/dev/null \
    | grep -oE '"ProductName"="[^"]*"' \
    | grep -qviE 'color lcd|built-?in'
}

# size (px) drives zed/iterm; dppx (Firefox's layout.css.devPixelsPerPx) is an
# absolute per-display override, so each context carries its own calibrated value.
if [ "${DISPLAY_FONT_FORCE:-}" = built-in ]; then
  size=$BASE_SIZE
  dppx=$BUILTIN_DPPX
  context="built-in (forced)"
elif [ "${DISPLAY_FONT_FORCE:-}" = external ] || external_connected; then
  size=$(printf '%.0f' $(( BASE_SIZE * EXTERNAL_SCALE )))
  dppx=$EXTERNAL_DPPX
  context=external
else
  size=$BASE_SIZE
  dppx=$BUILTIN_DPPX
  context=built-in
fi

changed=0

# Render a template to a generated (never-symlinked) target, but only rewrite
# when the content actually changes. Idempotence keeps the display-font agent
# from touching the files — and so from triggering needless hot-reloads — on
# every poll; only a genuine size flip rewrites and resizes open windows.
render() {
  template="$1" out="$2"
  [ -f "$template" ] || return 0
  outdir="$(dirname "$out")"
  mkdir -p "$outdir"
  [ -L "$out" ] && rm -f "$out"
  # Render to a temp OUTSIDE the target directory, then atomically move it in.
  # iTerm reads every file in its DynamicProfiles folder, so a *.tmp left there
  # — even briefly, and on every idempotent no-op poll — makes it choke on
  # half-written JSON or a duplicate Guid. The parent dir is on the same
  # filesystem, so the mv is a real atomic rename: iTerm only ever sees the
  # finished file appear.
  tmp="$outdir/../.display-font.$$.tmp"
  sed -e "s/__FONT_SIZE__/$size/g" -e "s/__DPPX__/$dppx/g" "$template" > "$tmp"
  if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$out"
    changed=1
  fi
}

render "$DOTFILES/.config/zed/settings.base.jsonc" "$HOME/.config/zed/settings.json"

if [ -d "$HOME/Library/Application Support/iTerm2" ]; then
  render "$DOTFILES/iterm2/seb.template.json" \
    "$HOME/Library/Application Support/iTerm2/DynamicProfiles/seb.json"
fi

# Firefox reads user.js only at startup, so unlike zed/iterm it won't resize a
# running window — the new scale lands on its next launch. Rendered into every
# profile so whichever one is launched picks it up.
for prof in "$HOME/Library/Application Support/Firefox/Profiles"/*/; do
  render "$DOTFILES/firefox/user.template.js" "$prof/user.js"
done

[ "$changed" -eq 1 ] && echo "display-font: $context display → ${size}px (zed, iterm); firefox → ${dppx} devPixelsPerPx (next launch)"
exit 0
