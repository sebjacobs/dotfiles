#compdef gwt

# Zsh completion for `gwt`. Candidates are grouped under bold, coloured, spaced
# headers (see _gwt_group): commands, worktrees, branches, endpoints, flags. The
# first word offers the subcommands (kept in sync with the binary's command list)
# alongside worktree names; the worktree-taking subcommands (cd/rm/path/edit/mv/
# sync/promote) complete an existing worktree, add completes branch names, and
# flag-taking subcommands offer their flags when the current word starts with `-`.

_gwt_root() { git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //'; }

# _gwt_group <tag> <colour> <items...> — add a completion group under its own
# bold, coloured header with a blank line above it. compadd's -X explanation
# supports prompt escapes (%B/%F) and an embedded newline, so the spacing and
# colour travel with the group rather than a global style. A no-op when empty.
_gwt_group() {
  local tag=$1 colour=$2; shift 2
  (( $# )) || return
  compadd -J "$tag" -X $'\n%B%F{'"$colour"$'}'"$tag"$'%f%b' -- "$@"
}

_gwt() {
  local root=$(_gwt_root)
  if [[ -z "$root" ]]; then return; fi
  local wt_base="$root/${GWT_WORKTREE_DIR:-.claude/worktrees}"

  zstyle ':completion:*:*:gwt:*' group-name ''
  zstyle ':completion:*:*:gwt:*' group-order commands worktrees branches endpoints flags

  local cur="${words[CURRENT]}"
  # Worktree names are shown decoded (feature+dogs -> feature/dogs); the folder
  # encoding is a storage detail, and gwt re-encodes on input so they round-trip.
  local -a wts
  if [[ -d "$wt_base" ]]; then wts=("$wt_base"/*(/:t)); wts=(${wts//+//}); fi

  # `gwt send ...`: --from/--to take an endpoint (root or a worktree), slot 3 is
  # the path to copy (files), later slots offer the flags.
  if [[ "${words[2]}" == send ]] && (( CURRENT >= 3 )); then
    case "${words[CURRENT-1]}" in
      --from|--to) _gwt_group endpoints cyan root $wts ;;
      *) if (( CURRENT == 3 )); then _files; else _gwt_group flags magenta --from --to -f -y; fi ;;
    esac
    return
  fi

  if (( CURRENT == 2 )); then
    local -a _subcommands=(init add eject sync promote send cd mv path edit ls rm prune root status)
    _gwt_group commands yellow $_subcommands
    _gwt_group worktrees cyan $wts
  elif (( CURRENT >= 3 )); then
    case "${words[2]}" in
      rm)
        if [[ "$cur" == -* ]]; then _gwt_group flags magenta -f -d -D; else _gwt_group worktrees cyan $wts; fi
        ;;
      sync)
        if [[ "$cur" == -* ]]; then _gwt_group flags magenta --all -f -y --hooks; else _gwt_group worktrees cyan $wts; fi
        ;;
      promote)
        if [[ "$cur" == -* ]]; then _gwt_group flags magenta -f -y; else _gwt_group worktrees cyan $wts; fi
        ;;
      cd|path|edit)
        (( CURRENT == 3 )) && _gwt_group worktrees cyan $wts
        ;;
      mv)
        if [[ "$cur" == -* ]]; then _gwt_group flags magenta -f
        elif (( CURRENT == 3 )); then _gwt_group worktrees cyan $wts; fi
        ;;
      add)
        if [[ "$cur" == -* ]]; then _gwt_group flags magenta -b
        else _gwt_group branches green $(git branch --format='%(refname:short)' 2>/dev/null); fi
        ;;
      root)
        _gwt_group flags magenta -p --path
        ;;
    esac
  fi
}

_gwt "$@"
